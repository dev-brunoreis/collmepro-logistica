APP_NAME="CollMe! Logística"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost/

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BLING_PRO_CLIENT_ID=
BLING_PRO_CLIENT_SECRET=
WOOCOMMERCE_PRO_URL=""
WOOCOMMERCE_PRO_CONSUMER_KEY=
WOOCOMMERCE_PRO_CONSUMER_SECRET=

BLING_ATACADISTA_CLIENT_ID=
BLING_ATACADISTA_CLIENT_SECRET=
WOOCOMMERCE_ATACADISTA_URL=""
WOOCOMMERCE_ATACADISTA_CONSUMER_KEY=
WOOCOMMERCE_ATACADISTA_CONSUMER_SECRET=

BLING_BASE_URL=https://bling.com.br/Api/v3
BLING_TIMEOUT=30
BLING_RETRY_ATTEMPTS=3
BLING_AUTH_URL=https://bling.com.br/Api/v3/oauth/authorize

# Broadcasting Configuration
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=collmepro-logistics
REVERB_APP_KEY=collmepro-logistics-key
REVERB_APP_SECRET=collmepro-logistics-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001
REVERB_HOST=logistica.collmepro.com.br
REVERB_PORT=443
REVERB_SCHEME=https

# Frontend Broadcasting
VITE_PUSHER_APP_KEY="${REVERB_APP_KEY}"
VITE_PUSHER_HOST="${REVERB_HOST}"
VITE_PUSHER_PORT="${REVERB_PORT}"
VITE_PUSHER_SCHEME="${REVERB_SCHEME}"

STATS_URL="http://144.22.134.103:3000/api/ping"
STATS_KEY=

# Bling API Configuration
BLING_RATE_LIMIT_DELAY_MS=25      # 40 req/s (safe margin)
BLING_API_TIMEOUT=30               # Request timeout in seconds
BLING_API_RETRY_ATTEMPTS=3         # Number of retry attempts