# Increase PHP memory limit to handle large JSON data processing
php_value memory_limit 256M
php_value max_execution_time 300

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Só redireciona se ainda não estiver dentro de /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>